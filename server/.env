Base de données PostgreSQL
DB_HOST=127.0.0.1
DB_USER=postgres          # ton utilisateur PostgreSQL
DB_PASSWORD=        # ton mot de passe PostgreSQL
DB_NAME=carte_talents     # nom de ta base de données
DB_DIALECT=postgres

# DATABASE_URL=postgres://postgres:12344321@db:5432/carte_talents
# Port du serveur
PORT=5000

# Clé secrète pour JWT
JWT_SECRET=monSecretSuperSecurise
